# 后端API地址
VITE_API_BASE_URL=

# 高德地图 Web服务 Key
VITE_AMAP_WEB_KEY=your_amap_web_service_key
# 高德地图 Web端(JS API) Key
VITE_AMAP_WEB_JS_KEY=your_amap_js_api_key
# 高德地图 JS API 2.0 安全密钥
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code

# 课程演示注册授权码
# 普通用户无需授权码；注册经理/管理员时需要对应授权码。
VITE_MANAGER_INVITE_CODE=LINGTU_MANAGER_2026
VITE_ADMIN_INVITE_CODE=LINGTU_ADMIN_2026
