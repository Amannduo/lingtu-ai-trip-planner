
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=deepseek-v4-pro

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=300

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 留空使用 backend/data/travel.db；生产环境推荐 PostgreSQL
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://lingtu_app:password@localhost:5432/lingtu_travel

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# 服务端认证配置
# 使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_COOKIE_NAME=lingtu_access_token
# 本地 HTTP 开发可保持 false；生产 HTTPS 必须设为 true。
# 即使为 false，当请求本身为 https 时 Cookie 仍会自动加 Secure。
AUTH_COOKIE_SECURE=false
# 留空表示不开放对应高权限角色自助注册
AUTH_MANAGER_INVITE_CODE=
AUTH_ADMIN_INVITE_CODE=

# 日志级别
LOG_LEVEL=INFO

# 语义契约硬拦截：未确认的关键 pending/冲突会在生成前返回 422。
# 前端二次确认后会在 free_text 写入 [用户已确认待核对约束] 以放行。
SEMANTIC_CONTRACT_HARD_BLOCK_ENABLED=true

# 周末/相对日期语义使用的业务时区（不是服务器本地时区）
BUSINESS_TIMEZONE=Asia/Shanghai

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 高德地图API配置
AMAP_API_KEY=
AMAP_ROUTE_MAX_SEGMENTS=24

# FlyAI/飞猪预算数据源配置
# 默认通过 npx 调用固定版本 @fly-ai/flyai-cli@1.0.16；如果已全局安装 flyai，可改为 FLYAI_CLI_COMMAND=flyai
FLYAI_ENABLED=false
FLYAI_API_KEY=
FLYAI_CLI_COMMAND=npx --yes @fly-ai/flyai-cli@1.0.16
FLYAI_TIMEOUT=25

# 火山引擎联网问答Agent配置
# 文档：https://www.volcengine.com/docs/85508/1510834?lang=zh
VOLCENGINE_AGENT_ENABLED=false
VOLCENGINE_AGENT_API_KEY=
VOLCENGINE_AGENT_BOT_ID=
VOLCENGINE_AGENT_API_URL=https://open.feedcoopapi.com/agent_api/agent/chat/completion
VOLCENGINE_AGENT_TIMEOUT=30
VOLCENGINE_AGENT_FORCE_WEB=true
VOLCENGINE_AGENT_MODEL=

# 智谱 Web Search（联网攻略检索供应商）
# 文档：https://docs.bigmodel.cn/cn/guide/tools/web-search
# 未配置或调用失败时降级为本地攻略模板，不阻断行程生成。
WEB_SEARCH_PROVIDER=zhipu
ZHIPU_SEARCH_ENABLED=false
ZHIPU_SEARCH_API_KEY=
ZHIPU_SEARCH_API_URL=https://open.bigmodel.cn/api/paas/v4/web_search
ZHIPU_SEARCH_ENGINE=search_pro
ZHIPU_SEARCH_TIMEOUT=15
ZHIPU_SEARCH_MAX_RESULTS=8
ZHIPU_SEARCH_MAX_RETRIES=1
ZHIPU_SEARCH_MAX_RESPONSE_BYTES=2000000

# 初始化或补齐可选的合成分析数据（SQLite/PostgreSQL 均支持）：
#   python scripts/seed_travel_data.py --rows 1000

# Web Push / VAPID (keep the real private key only in backend/.env)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_MAX_RETRIES=2
WEB_PUSH_RETRY_DELAY_SECONDS=0.25
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_TIMEOUT_SECONDS=15
WEB_PUSH_DNS_TIMEOUT_SECONDS=3
WEB_PUSH_MAX_SUBSCRIPTIONS_PER_USER=20
WEB_PUSH_DELIVERY_BUDGET_SECONDS=30
# Required when Web Push is configured. Restrict to trusted browser push hosts.
# Example: fcm.googleapis.com,push.services.mozilla.com,updates.push.services.mozilla.com,notify.windows.com,web.push.apple.com
WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,push.services.mozilla.com,updates.push.services.mozilla.com,notify.windows.com,web.push.apple.com

# SMTP 邮件发送配置
# 不配置时 send_email_tool 会 dry-run，只生成邮件内容但不真实发送。
SEND_REAL_EMAILS=false

# Shared total wall-clock budget for synchronous and progressive trip generation.
TRIP_GENERATION_MAX_RUNTIME_SECONDS=600
# Process-local create rate for POST /api/trip/plan and /api/trip/plan-jobs
# (per authenticated user, or per client IP when anonymous). Not cluster-wide.
TRIP_GENERATION_RATE_LIMIT=10
TRIP_GENERATION_RATE_WINDOW_SECONDS=60

# SMTP 邮件发送配置
# 不配置时 send_email_tool 会 dry-run，只生成邮件内容但不真实发送。
SEND_REAL_EMAILS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=20
SMTP_SSL=false
# Transient SMTP/network failures only; hard-capped (max 2 extra attempts).
SMTP_MAX_RETRIES=1
SMTP_RETRY_DELAY_SECONDS=0.5
EMAIL_QUOTA_ENABLED=true
# Per authenticated user (UTC day) and peer IP (UTC hour) attempt budgets.
# Attempts are pre-consumed before SMTP; failures still occupy the budget.
EMAIL_USER_DAILY_LIMIT=10
EMAIL_IP_HOURLY_LIMIT=30

# QQ 邮箱示例：
# SEND_REAL_EMAILS=true
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=your_qq_number@qq.com
# SMTP_PASSWORD=your_qq_smtp_authorization_code
# SMTP_FROM=your_qq_number@qq.com
# SMTP_SSL=true
#
# 兼容旧变量名：EMAIL_HOST、EMAIL_PORT、EMAIL_USER、EMAIL_PASSWORD、EMAIL_FROM、EMAIL_SSL。

# 推荐会话契约令牌的独立签名密钥（可选；留空时从 AUTH_SECRET_KEY 经 HKDF 域分离派生，不会直接复用主密钥）
RECOMMENDATION_TOKEN_SIGNING_KEY=


# S4c 开关：是否继续把【…】机器块写入推荐 form_patch 的额外要求（默认开=双通道；令牌路径观察稳定后可改为 false 停写，后端始终保留旧格式读取兼容）
RECOMMENDATION_MACHINE_BLOCK_WRITE_ENABLED=true
