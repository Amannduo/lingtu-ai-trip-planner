
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=deepseek-v4-pro

# API密钥
LLM_API_KEY=your_llm_api_key

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key

# FlyAI/飞猪预算数据源配置
# 默认通过 npx 调用 @fly-ai/flyai-cli；如果已全局安装 flyai，可改为 FLYAI_CLI_COMMAND=flyai
FLYAI_ENABLED=true
FLYAI_API_KEY=
FLYAI_CLI_COMMAND=npx --yes @fly-ai/flyai-cli
FLYAI_TIMEOUT=25

# 火山引擎联网问答Agent配置
# 文档：https://www.volcengine.com/docs/85508/1510834?lang=zh
VOLCENGINE_AGENT_ENABLED=true
VOLCENGINE_AGENT_API_KEY=your_volcengine_agent_api_key
VOLCENGINE_AGENT_BOT_ID=your_volcengine_agent_bot_id
VOLCENGINE_AGENT_API_URL=https://open.feedcoopapi.com/agent_api/agent/chat/completion
VOLCENGINE_AGENT_TIMEOUT=30
VOLCENGINE_AGENT_FORCE_WEB=true
VOLCENGINE_AGENT_MODEL=

# SQLite 数据集说明
# 当前课程设计默认使用 backend/data/travel.db，无需配置 DATABASE_URL。
# 初始化/补齐 10000 条真实模拟旅行计划数据：
#   python backend/scripts/init_travel_sqlite.py --rows 10000

# SMTP 邮件发送配置
# 不配置时 send_email_tool 会 dry-run，只生成邮件内容但不真实发送。
SEND_REAL_EMAILS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=20
SMTP_SSL=false

# QQ 邮箱示例：
# SEND_REAL_EMAILS=true
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=your_qq_number@qq.com
# SMTP_PASSWORD=your_qq_smtp_authorization_code
# SMTP_FROM=your_qq_number@qq.com
# SMTP_SSL=true
#
# 兼容旧变量名：EMAIL_HOST、EMAIL_PORT、EMAIL_USER、EMAIL_PASSWORD、EMAIL_FROM、EMAIL_SSL。
